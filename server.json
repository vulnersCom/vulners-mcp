{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.vulnersCom/vulners-mcp",
  "description": "MCP server for the Vulners.com API",
  "repository": {
    "url": "https://github.com/vulnersCom/vulners-mcp",
    "source": "github"
  },
  "version": "1.15.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "vulners-mcp",
      "version": "1.15.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VULNERS_API_KEY",
          "description": "Your Vulners API key (https://vulners.com/userinfo)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/vulnerscom/vulners-mcp:1.15.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VULNERS_API_KEY",
          "description": "Your Vulners API key (https://vulners.com/userinfo)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.vulners.com/mcp"
    }
  ]
}
